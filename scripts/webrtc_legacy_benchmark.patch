diff --git a/core/src/commonTest/kotlin/com/folderspan/service/webrtc/LegacyWebRtcBenchmark.kt b/core/src/commonTest/kotlin/com/folderspan/service/webrtc/LegacyWebRtcBenchmark.kt
new file mode 100644
index 00000000..e789ae27
--- /dev/null
+++ b/core/src/commonTest/kotlin/com/folderspan/service/webrtc/LegacyWebRtcBenchmark.kt
@@ -0,0 +1,121 @@
+package com.folderspan.service.webrtc
+
+import com.folderspan.service.webrtc.controller.rpc.MultiPeerWebRtcControllerDeviceRpc
+import com.folderspan.service.webrtc.models.*
+import com.folderspan.service.webrtc.signaling.SignalingDevice
+import kotlinx.coroutines.*
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.update
+import kotlin.test.assertEquals
+import kotlin.time.TimeSource
+
+internal suspend fun measureLegacyProtocol(sampleMemory: () -> Long) = coroutineScope {
+        withTimeout(120_000L) {
+            val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+            val peakBuffered = MutableStateFlow(0L)
+            val sender = BenchmarkController(scope)
+            val receiver = BenchmarkController(scope)
+            val left = WebRtcPeerConnection(emptyList())
+            val right = WebRtcPeerConnection(emptyList())
+            val readyLeft = CompletableDeferred<Unit>()
+            val readyRight = CompletableDeferred<Unit>()
+            val leftSession = sender.install(left, "right").also { it.isOfferer = true }
+            val rightSession = receiver.install(right, "left")
+            val forward = launch(start = CoroutineStart.UNDISPATCHED) {
+                left.onIceCandidate.collect { readyRight.await(); right.addIceCandidate(it) }
+            }
+            val backward = launch(start = CoroutineStart.UNDISPATCHED) {
+                right.onIceCandidate.collect { readyLeft.await(); left.addIceCandidate(it) }
+            }
+            val incoming = scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                right.onDataChannel.collect { receiver.attach(rightSession, it) }
+            }
+            var stage = "negotiate"
+            var primaryFailure: Throwable? = null
+            var sampling: Job? = null
+            try {
+                val control = checkNotNull(left.createDataChannel("control"))
+                sender.attach(leftSession, control)
+                val offer = left.createOffer()
+                left.setLocalDescription(offer)
+                right.setRemoteDescription(offer)
+                readyRight.complete(Unit)
+                val answer = right.createAnswer()
+                right.setLocalDescription(answer)
+                left.setRemoteDescription(answer)
+                readyLeft.complete(Unit)
+                stage = "wait-control-channel"
+                while (!leftSession.isConnected() || !rightSession.isConnected()) delay(10)
+                stage = "warmup-send"
+                sender.sendRandomPayload(leftSession, 256L * 1024)
+                stage = "warmup-receive"
+                receiver.transfers.first { entries -> entries.size == 1 && entries.values.all { it.status == TransferStatus.Completed } }
+                for (concurrency in listOf(1, 4)) {
+                  repeat(3) { iteration ->
+                    stage = "sample-$concurrency-$iteration"
+                    val before = receiver.transfers.value.size
+                    val beforeBytes = receiver.transfers.value.values.sumOf { it.transferredBytes }
+                    peakBuffered.value = 0L
+                    val baselineMemory = sampleMemory()
+                    var peakHeap = baselineMemory
+                    sampling = launch {
+                        while (isActive) {
+                            peakBuffered.update { maxOf(it, leftSession.activeChannels.sumOf { channel -> channel.bufferedAmount }) }
+                            peakHeap = maxOf(peakHeap, sampleMemory())
+                            delay(2)
+                        }
+                    }
+                    val mark = TimeSource.Monotonic.markNow()
+                    (1..concurrency).map { async { sender.sendRandomPayload(leftSession, 4L * 1024 * 1024) } }.awaitAll()
+                    check(sender.transfers.value.values.none { it.status == TransferStatus.Failed }) { sender.transfers.value.toString() }
+                    val results = receiver.transfers.first { entries ->
+                        entries.size == before + concurrency && entries.values.all { it.status == TransferStatus.Completed }
+                    }
+                    val elapsedMs = mark.elapsedNow().inWholeMilliseconds
+                    sampling.cancelAndJoin()
+                    sampling = null
+                    assertEquals(beforeBytes + concurrency * 4L * 1024 * 1024, results.values.sumOf { it.transferredBytes })
+                    println("WEBRTC_BENCH protocol=legacy iteration=$iteration concurrent=$concurrency bytes=${concurrency * 4L * 1024 * 1024} elapsedMs=$elapsedMs sampledPeakBuffered=${peakBuffered.value} baselineMemory=$baselineMemory peakMemory=$peakHeap")
+                  }
+                }
+            } catch (error: Throwable) {
+                primaryFailure = error
+                println("WEBRTC_BENCH_STATE stage=$stage left=${leftSession.controlChannel?.state} right=${rightSession.controlChannel?.state} sender=${sender.transfers.value.values.map { it.status }} receiver=${receiver.transfers.value.values.map { it.status }}")
+                throw error
+            } finally {
+                withContext(NonCancellable) {
+                    var failure = primaryFailure
+                    val actions: List<suspend () -> Unit> = listOf(
+                        { sampling?.cancelAndJoin() },
+                        { forward.cancelAndJoin() },
+                        { backward.cancelAndJoin() },
+                        { incoming.cancelAndJoin() },
+                        { sender.dispose() },
+                        { receiver.dispose() },
+                        { scope.coroutineContext.job.cancelAndJoin() },
+                    )
+                    for (action in actions) {
+                        try { withTimeout(5_000L) { action() } } catch (error: Throwable) {
+                            if (failure == null) failure = error
+                            else if (failure !== error) failure.addSuppressed(error)
+                        }
+                    }
+                    if (primaryFailure == null) failure?.let { throw it }
+                }
+            }
+        }
+}
+
+private class BenchmarkController(scope: CoroutineScope) : MultiPeerWebRtcControllerDeviceRpc(scope) {
+    fun install(connection: WebRtcPeerConnection, id: String): PeerSession =
+        PeerSession(SignalingDevice(id = id, name = id)).also {
+            it.peerConnection = connection
+            it.status = WebRtcConnectionStatus.Connected
+            it.connectRequested = true
+            peerSessions[id] = it
+        }
+    fun attach(session: PeerSession, channel: WebRtcDataChannel) =
+        attachDataChannel(session, channel, session.generation, ChannelOrigin.Remote)
+    fun dispose() = disconnectInternal(clearConfig = true, clearTransfers = true)
+}
