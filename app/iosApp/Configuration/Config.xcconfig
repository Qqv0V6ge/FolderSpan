TEAM_ID=

PRODUCT_NAME=FolderSpan
PRODUCT_BUNDLE_IDENTIFIER=com.folderspan.FolderSpan$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

IOS_NATIVE_XCFRAMEWORKS_ROOT = $(HOME)/ios-native-xcframeworks

FOLDERSPAN_HAS_PRO_MAIN = NO
#include? "../../../proMain/host/ios/Config.xcconfig"
FOLDERSPAN_INCLUDE_PRO_ = $(FOLDERSPAN_HAS_PRO_MAIN)
FOLDERSPAN_INCLUDE_PRO_true = $(FOLDERSPAN_HAS_PRO_MAIN)
FOLDERSPAN_INCLUDE_PRO_false = NO
FOLDERSPAN_INCLUDE_PRO = $(FOLDERSPAN_INCLUDE_PRO_$(ORG_GRADLE_PROJECT_includeProMain))

FOLDERSPAN_WEBRTC_ROOT = $(SRCROOT)/Pods/WebRTC-SDK/WebRTC.xcframework
FOLDERSPAN_WEBRTC_SLICE[sdk=iphoneos*] = ios-arm64
FOLDERSPAN_WEBRTC_SLICE[sdk=iphonesimulator*] = ios-arm64_x86_64-simulator
FOLDERSPAN_WEBRTC_SEARCH_YES = $(FOLDERSPAN_WEBRTC_ROOT)/$(FOLDERSPAN_WEBRTC_SLICE)
FOLDERSPAN_WEBRTC_SEARCH = $(FOLDERSPAN_WEBRTC_SEARCH_$(FOLDERSPAN_INCLUDE_PRO))
FOLDERSPAN_WEBRTC_LINK_YES = -framework WebRTC
FOLDERSPAN_WEBRTC_LINK = $(FOLDERSPAN_WEBRTC_LINK_$(FOLDERSPAN_INCLUDE_PRO))
