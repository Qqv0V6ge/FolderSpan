#!/bin/sh
case "$XDG_DATA_HOME" in
    /*) ;;
    *) printf '%s\n' 'FolderSpan: XDG_DATA_HOME must be an absolute path' >&2; exit 1 ;;
esac
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Djava.util.prefs.userRoot=\"$XDG_DATA_HOME/FolderSpan\""
exec /app/folderspan/bin/FolderSpan "$@"
