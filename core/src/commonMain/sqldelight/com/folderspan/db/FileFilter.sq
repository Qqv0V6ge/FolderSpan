import com.folderspan.data.file.FileFilterType;
import kotlin.String;
import kotlin.collections.List;

CREATE TABLE FileFilter
(
    id         INTEGER NOT NULL CONSTRAINT File_Filter_PK_2 PRIMARY KEY AUTOINCREMENT CONSTRAINT File_Filter_PK UNIQUE,
    name       TEXT                       NOT NULL,
    type       TEXT    AS FileFilterType  NOT NULL,
    extensions TEXT    AS List<String>    NOT NULL,
    icon       TEXT,
    sort       INTEGER NOT NULL
);

CREATE UNIQUE INDEX file_filter_id_uindex ON FileFilter (id);

-- Built-in `name` values are language-neutral type keys. UI localizes by `type`.
INSERT INTO FileFilter (id, name, type, extensions, sort)
VALUES (1, "Image", "Image", ".jpg,.jpeg,.png,.gif,.webp,.bmp,.tif,.tiff,.heic,.heif,.avif", 24);

